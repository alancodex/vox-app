{
  "version": 2,
  "builds": [
    {
      "src": "front-end/**/*",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"  
      }
    },
    {
      "src": "backend/index.js",  
      "use": "@vercel/node"
    },
    {
      "src": "api/main.py",       
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",         
      "dest": "api/main.py"
    },
    {
      "src": "/chat",             
      "dest": "backend/index.js"
    },
    {
      "src": "/(.*)",            
      "dest": "front-end/dist/$1"
    }
  ]
}